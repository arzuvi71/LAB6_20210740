<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LAB6_20210740" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores principales de la app -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/botones</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/botones</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Colores de fondo -->
        <item name="android:colorBackground">@color/light_gray</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Colores de error -->
        <item name="colorError">#B00020</item>
        <item name="colorOnError">@color/white</item>

        <!-- Estilo de botones -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <style name="Theme.LAB6_20210740" parent="Base.Theme.LAB6_20210740" />

    <!-- Estilo personalizado para botones -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>